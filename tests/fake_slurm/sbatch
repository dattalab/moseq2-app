"""Stands in for ``sbatch`` in the tests: queues a job in ``$FAKE_SLURM_STATE`` and, unless told to hold it, runs it.

    sbatch [--parsable] [-J NAME] [-o LOG] [-c N] [--mem=M] [-p PARTITION] [-t TIME] --wrap COMMAND

With ``--parsable`` it prints the job id alone, as the real one does; without,
``Submitted batch job <id>``. ``_cluster`` describes the settings
(``FAKE_SLURM_PENDING``, ``FAKE_SLURM_FAIL``). ``sbatch --fake-run <id>`` is the
job itself, started in a session of its own: it marks the job running, runs its
command (or ends it in the state ``FAKE_SLURM_FAIL`` names) and records how it
ended.
"""

import os
import subprocess
import sys
import time

import _cluster

#: What sbatch prints when it refuses a job (``FAKE_SLURM_FAIL=REFUSED:<text>``).
REFUSAL = "sbatch: error: Batch job submission failed: Invalid partition name specified"

#: The exit code sacct shows for a job that ended in each state.
EXIT_CODES = {"OUT_OF_MEMORY": "0:125", "TIMEOUT": "0:15", "FAILED": "1:0", "NODE_FAIL": "0:0"}

#: The flags that take a value, and the field each fills.
VALUED = {"-J": "name", "--job-name": "name", "-o": "log", "--output": "log", "-c": "cpus", "-p": "partition",
          "-t": "time", "--wrap": "command"}


def parse(args):
    job = {"parsable": False}
    words = iter(args)
    for word in words:
        if word == "--parsable":
            job["parsable"] = True
        elif word in VALUED:
            job[VALUED[word]] = next(words)
        elif word.startswith("--mem="):
            job["memory"] = word.split("=", 1)[1]
        elif "=" in word and word.split("=", 1)[0] in VALUED:
            name, value = word.split("=", 1)
            job[VALUED[name]] = value
    return job


def submit(args):
    _cluster.log_call("sbatch", args)
    job = parse(args)
    command = job.get("command")
    if command is None:
        print("sbatch: error: this fake runs --wrap commands only", file=sys.stderr)
        return 1
    ends = None
    for state, text in _cluster.failures():
        if text in command:
            if state == "REFUSED":
                print(REFUSAL, file=sys.stderr)
                return 1
            ends = state
    with _cluster.locked():
        job_id = _cluster.next_id()
        _cluster.save({"id": job_id, "name": job.get("name"), "log": job.get("log"), "command": command,
                       "args": args, "state": "PENDING", "reason": "Priority", "exit_code": "0:0", "pid": None,
                       "ends": ends})
    if os.environ.get("FAKE_SLURM_PENDING") != "1":
        subprocess.Popen([sys.executable, __file__, "--fake-run", job_id], start_new_session=True,
                         stdin=subprocess.DEVNULL, stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    print(job_id if job["parsable"] else f"Submitted batch job {job_id}")
    return 0


def run(job_id):
    job = _cluster.load(job_id)
    if job is None or job["state"] != "PENDING":
        return 0
    job = _cluster.update(job_id, state="RUNNING", reason="None", pid=os.getpid(), started=time.time())
    if job["state"] != "RUNNING":
        return 0
    if job.get("ends"):
        _cluster.update(job_id, state=job["ends"], exit_code=EXIT_CODES.get(job["ends"], "0:0"), pid=None)
        return 0
    env = {**os.environ, "SLURM_JOB_ID": job_id}
    log = open(job["log"], "w") if job.get("log") else open(os.devnull, "w")
    with log:
        code = subprocess.call(["/bin/sh", "-c", job["command"]], stdin=subprocess.DEVNULL, stdout=log,
                               stderr=subprocess.STDOUT, env=env)
    _cluster.update(job_id, state="COMPLETED" if code == 0 else "FAILED", exit_code=f"{code}:0", pid=None)
    return 0


if __name__ == "__main__":
    if sys.argv[1:2] == ["--fake-run"]:
        sys.exit(run(sys.argv[2]))
    sys.exit(submit(sys.argv[1:]))
